# Copy to .env.local (git-ignored). The address of the backend API.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Which chamber the bare /client/login link belongs to — the chamber whose
# website this is. Must match the backend's PLATFORM_FIRM_SLUG. Every other
# chamber's clients arrive at /client/login/<their-chamber> instead.
NEXT_PUBLIC_PLATFORM_FIRM_SLUG=arbitrator-law

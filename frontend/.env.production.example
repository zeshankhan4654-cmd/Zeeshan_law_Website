# Copy to .env.production on the server, BEFORE running the build.
#
# Everything here is compiled into the browser bundle by `next build`, not
# read when the server starts — so a wrong value produces a site that
# builds cleanly and then calls the wrong address from a visitor's browser.

# Where the API is reachable from a visitor's browser, not from the server.
NEXT_PUBLIC_API_URL=https://api.arbitratorandlaw.com

# Which chamber the bare /client/login link belongs to — the chamber whose
# website this is. Must match the backend's PLATFORM_FIRM_SLUG.
NEXT_PUBLIC_PLATFORM_FIRM_SLUG=arbitrator-law

  /// rejection that does not say why is one the chamber cannot act on.
  shareNote   String    @default("") @map("share_note")
  /// The handle of whoever submitted it, for the chamber's own record.
  submittedBy String    @default("") @map("submitted_by")

  case Case? @relation(fields: [caseId], references: [id], onDelete: SetNull)


// The platform's data model. camelCase in code, snake_case in the database
// (via @map/@@map), so both SQL and TypeScript read naturally.
//
// Every table that holds a chamber's work carries `firmId`. It is
// denormalised deliberately — a hearing could be reached through its case,
// but a key on the row itself means every query can be scoped directly, and
// the tenant client (src/lib/tenant.ts) can enforce that uniformly instead
// of each call site remembering to join.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// The platform
// ---------------------------------------------------------------------------

/// A chamber: one lawyer's practice, with its own staff, clients and files.
///
/// Every other table below belongs to exactly one of these, and nothing in
/// one firm is reachable from another. The platform's own chamber is simply
/// the first row.
model Firm {
  id              Int    @id @default(autoincrement())
  /// Used in URLs and invitations, e.g. "arbitrator-law".
  slug            String @unique
  name            String
  /// "active" | "suspended" — a suspended chamber cannot sign in at all.
  status          String @default("active")
  /// Set when the platform admin suspends it, for the message shown.
  suspendedReason String @default("") @map("suspended_reason")

  /// Whether the platform has checked that this really is an advocate.
  ///
  /// Anybody can type "advocate" into a sign-up form, so every chamber
  /// starts unverified. This deliberately does NOT restrict a chamber's own
  /// private use — that use is the product, and gating it on a manual check
  /// would mean nobody could start work on the day they signed up. It gates
  /// what becomes *public* in the chamber's name, and gives the platform
  /// admin something to act on.
  verified    Boolean  @default(false)
  /// Free text: an enrolment or bar council number as the advocate gave it.
  /// Stored as given and never treated as proof of anything by itself.
  enrolmentNo String   @default("") @map("enrolment_no")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users          User[]
  roles          Role[]
  roleCaps       RoleCap[]
  clients        Client[]
  cases          Case[]
  hearings       Hearing[]
  caseUpdates    CaseUpdate[]
  caseMessages   CaseMessage[]
  documents      Document[]
  fees           Fee[]
  officialFees   OfficialFee[]
  expenses       Expense[]
  communications Communication[]
  judgments      Judgment[]
  research       Research[]
  media          Media[]
  enquiries      Enquiry[]
  settings       Setting[]
  testimonials   Testimonial[]
  posts          Post[]
  pushTokens     PushToken[]

  @@map("firms")
}

// ---------------------------------------------------------------------------
// Accounts, roles and access
// ---------------------------------------------------------------------------

/// A staff account. The Principal (role "admin") always holds every
/// capability regardless of what role_caps says — enforced in application
/// code, not here, so a future capability is automatically covered.
model User {
  id Int @id @default(autoincrement())

  /// How this person signs in. Unique across the whole platform, because an
  /// address is already one person's and needs no chamber named beside it.
  /// An address ending `.invalid` is a placeholder written by the migration
  /// for an account that pre-dates email sign-in; it works, but the holder
  /// should replace it.
  email String @unique

  /// The handle inside the chamber — what signs a case update. Two chambers
  /// may each have a `naveed.ahmad`, which is the whole point of M2: the
  /// second advocate to join must not be told a name is taken because
  /// somebody in a chamber they cannot see is using it.
  username String

  passwordHash       String   @map("password_hash")
  fullName           String   @map("full_name")
  role               String
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  createdAt          DateTime @default(now()) @map("created_at")

  /// Runs the platform itself, not merely this chamber.
  ///
  /// Deliberately a property of a person rather than of a chamber. Tying it
  /// to "any Principal of the first chamber" would mean that the day a
  /// colleague is made Principal, they silently acquire the power to
  /// suspend other advocates' practices.
  ///
  /// It grants exactly what running a platform needs — chamber metadata,
  /// counts, verification and suspension — and nothing that reaches inside
  /// a chamber. There is no route anywhere that takes a chamber id and
  /// returns its records; see lib/platform-stats.ts.
  ///
  /// Granted only from the command line (npm run platform:grant), never
  /// through a screen, so it cannot be handed out by a session somebody
  /// left signed in.
  platformAdmin Boolean @default(false) @map("platform_admin")

  firmId Int  @map("firm_id")
  firm   Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@unique([firmId, username])
  @@index([firmId])
  @@map("users")
}

/// A role staff accounts are assigned. Three ship as defaults (admin, editor,
/// associate) but "Add a role of your own" is a first-class feature — any
/// role_key not in that starting set is just as valid.
model Role {
  id          Int      @id @default(autoincrement())
  roleKey     String   @map("role_key")
  label       String
  description String   @default("")
  isSystem    Boolean  @default(false) @map("is_system")
  sortOrder   Int      @default(50) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  firmId Int  @map("firm_id")
  firm   Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  // Each chamber names its own roles; two firms may both have a "Clerk".
  @@unique([firmId, roleKey])
  @@map("roles")
}

/// Which capabilities a role holds. The capability keys themselves
/// ("cases.view", "money.edit", ...) are defined in application code
/// (src/lib/capabilities.ts), not as a database enum, so the list can grow
/// without a migration.
model RoleCap {
  roleKey String @map("role_key")
  cap     String

  firmId Int  @map("firm_id")
  firm   Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@id([firmId, roleKey, cap])
  @@map("role_caps")
}

/// A device registered for push notifications, bound to the party that was
/// signed in when it registered. The token is unique: a handset that signs
/// in as somebody else is reassigned, never shared, so the previous holder's
/// notifications stop reaching it.
model PushToken {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  /// "client" | "staff" — the same two audiences as a session.
  kind       String
  subjectId  Int      @map("subject_id")
  platform   String   @default("")
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @updatedAt @map("last_seen_at")

  firmId Int  @map("firm_id")
  firm   Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId, kind, subjectId])
  @@map("push_tokens")
}

/// A counter of attempts, keyed by (scope, identity, ip).
///
/// Two things use it: sign-in throttling — where a client login and an office
/// login for the same name are counted independently — and the public
/// enquiry form, the one unauthenticated write on the site. The shape suits
/// both, so they share a table rather than a near-duplicate one.
/// What a platform admin did to somebody else's chamber, and why.
///
/// The counterpart of the power itself. Suspending a chamber stops an
/// advocate working, so it is not something that should be possible to do
/// quietly — every use is written down here with who did it and the reason
/// they gave. Platform-level by nature, so it carries no firm_id of its
/// own; `firm_id_acted_on` names the chamber it was done to.
model PlatformAudit {
  id            Int      @id @default(autoincrement())
  /// users.id of the platform admin. Not a relation: the record must
  /// outlive the account, or deleting yourself would erase what you did.
  actorId       Int      @map("actor_id")
  actorEmail    String   @map("actor_email")
  /// "verify" | "unverify" | "suspend" | "restore"
  action        String
  firmIdActedOn Int      @map("firm_id_acted_on")
  firmSlug      String   @map("firm_slug")
  reason        String   @default("")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([firmIdActedOn, createdAt])
  @@index([createdAt])
  @@map("platform_audit")
}

/// Deliberately *not* scoped to a chamber. A brute-forcer working through
/// usernames is one attacker whichever chamber they are guessing at, and the
/// throttle runs before a sign-in has told us which chamber that would be.
model RateLimit {
  id          Int       @id @default(autoincrement())
  scope       String
  identity    String
  ip          String
  attempts    Int       @default(0)
  lockedUntil DateTime? @map("locked_until")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([scope, identity, ip])
  @@map("rate_limits")
}

// ---------------------------------------------------------------------------
// Clients and cases
// ---------------------------------------------------------------------------

model Client {
  id                       Int      @id @default(autoincrement())
  name                     String
  phone                    String   @default("")
  email                    String   @default("")
  address                  String   @default("")
  portalEnabled            Boolean  @default(false) @map("portal_enabled")
  /// Unique within the chamber, not the platform. A client may have no
  /// email at all — an elderly litigant very often does not — so they keep
  /// a username, and the chamber comes from the link their advocate sent
  /// them rather than from anything they have to remember.
  portalUsername           String?  @map("portal_username")
  portalHash               String?  @map("portal_hash")
  /// Set when the office issues or resets a portal password; the portal
  /// refuses every other route until the client has chosen their own.
  portalMustChangePassword Boolean  @default(false) @map("portal_must_change_password")
  portalShowFees           Boolean  @default(false) @map("portal_show_fees")
  notes                    String   @default("")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  cases          Case[]
  communications Communication[]

  firmId Int  @map("firm_id")
  firm   Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@unique([firmId, portalUsername])
  @@index([firmId])
  @@map("clients")
}

model Case {
  id          Int       @id @default(autoincrement())
  clientId    Int       @map("client_id")
  title       String
  court       String    @default("")
  caseType    String    @default("") @map("case_type")
  status      String    @default("Active")
  nextHearing DateTime? @map("next_hearing") @db.Date
  /// Internal only — never shown to the client portal.
  notes       String    @default("")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  client    Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  hearings  Hearing[]
  updates   CaseUpdate[]
  messages  CaseMessage[]
  documents Document[]
  fees      Fee[]
  research  Research[]

  firmId Int  @map("firm_id")
  firm   Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId])
  @@index([clientId])
  @@map("cases")
}

model Hearing {
  id             Int       @id @default(autoincrement())
  caseId         Int       @map("case_id")
  hearingDate    DateTime  @map("hearing_date") @db.Date
  purpose        String    @default("")
  /// Internal only — never shown to the client portal.
  outcome        String    @default("")
  /// When the reminder for this hearing went out, so a re-run of the
  /// reminder job never tells anyone twice.
  reminderSentAt DateTime? @map("reminder_sent_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  firmId Int  @map("firm_id")
  firm   Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId])
  @@index([caseId])
  @@map("hearings")
}

/// A progress note posted to a case. Client-visible by design — this is how
/// a client sees what has happened without phoning the office.
model CaseUpdate {
  id         Int      @id @default(autoincrement())
  caseId     Int      @map("case_id")
  updateDate DateTime @map("update_date") @db.Date
  message    String
  author     String
  createdAt  DateTime @default(now()) @map("created_at")

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  firmId Int  @map("firm_id")
  firm   Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId])
  @@index([caseId])
  @@map("case_updates")
}

/// The message thread between a client and the office on one case, including
/// client voice notes (storedName set when the message carries a recording).
model CaseMessage {
  id         Int      @id @default(autoincrement())
  caseId     Int      @map("case_id")
  authorType String   @map("author_type") // "client" | "office"
  authorName String   @default("") @map("author_name")
  body       String   @default("")
  storedName String   @default("") @map("stored_name")
  origName   String   @default("") @map("orig_name")
  answered   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  firmId Int  @map("firm_id")
  firm   Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId])
  @@index([caseId])
  @@map("case_messages")
}

model Document {
  id            Int      @id @default(autoincrement())
  caseId        Int      @map("case_id")
  title         String
  storedName    String   @default("") @map("stored_name")
  origName      String   @default("") @map("orig_name")
  sizeBytes     Int      @default(0) @map("size_bytes")
  /// Private by default — an office action must deliberately mark a
  /// document Shared before a client can see it.
  clientVisible Boolean  @default(false) @map("client_visible")
  createdAt     DateTime @default(now()) @map("created_at")

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  firmId Int  @map("firm_id")
  firm   Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId])
  @@index([caseId])
  @@map("documents")
}

// ---------------------------------------------------------------------------
// Money
// ---------------------------------------------------------------------------

model Fee {
  id        Int      @id @default(autoincrement())
  caseId    Int      @map("case_id")
  kind      String // "agreed" | "received"
  amount    Decimal  @db.Decimal(12, 2)
  entryDate DateTime @map("entry_date") @db.Date
  note      String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  firmId Int  @map("firm_id")
  firm   Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId])
  @@index([caseId])
  @@map("fees")
}

model OfficialFee {
  id        Int      @id @default(autoincrement())
  caseId    Int?     @map("case_id")
  kind      String
  amount    Decimal  @db.Decimal(12, 2)
  entryDate DateTime @map("entry_date") @db.Date
  note      String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  firmId Int  @map("firm_id")
  firm   Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId])
  @@map("official_fees")
}

model Expense {
  id          Int      @id @default(autoincrement())
  category    String
  amount      Decimal  @db.Decimal(12, 2)
  expenseDate DateTime @map("expense_date") @db.Date
  description String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")

  firmId Int  @map("firm_id")
  firm   Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId])
  @@map("expenses")
}

// ---------------------------------------------------------------------------
// Diary
// ---------------------------------------------------------------------------

model Communication {
  id          Int       @id @default(autoincrement())
  clientId    Int?      @map("client_id")
  method      String // "call" | "email" | "in_person"
  summary     String
  commDate    DateTime  @map("comm_date") @db.Date
  followUpDue DateTime? @map("follow_up_due") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at")

  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  firmId Int  @map("firm_id")
  firm   Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId])
  @@index([clientId])
  @@map("communications")
}

// ---------------------------------------------------------------------------
// Library — public once published
// ---------------------------------------------------------------------------

model Judgment {
  id           Int       @id @default(autoincrement())
  title        String
  citation     String    @default("")
  court        String    @default("")
  judges       String    @default("")
  judgmentDate DateTime? @map("judgment_date") @db.Date
  sections     String    @default("")
  principle    String    @default("")
  summary      String    @default("")
  tags         String    @default("")
  sourceUrl    String    @default("") @map("source_url")
  storedName   String    @default("") @map("stored_name")
  origName     String    @default("") @map("orig_name")
  sizeBytes    Int       @default(0) @map("size_bytes")
  published    Boolean   @default(false)
  createdAt    DateTime  @default(now()) @map("created_at")
  /// Whether this has been contributed to the shared library, and how far
  /// that has got: "private" | "pending" | "approved" | "rejected".
  ///
  /// A separate axis from `published`. `published` is the chamber's own
  /// decision about its own website; this is a decision to put the entry in
  /// front of every advocate on the platform, which only the platform admin
  /// can complete. An approved entry is a legal citation another advocate
  /// may rely on in court, so nothing reaches that state without somebody
  /// having checked it.
  shareState   String    @default("private") @map("share_state")
  /// When it was approved. Null until then.
  sharedAt     DateTime? @map("shared_at")
  /// The moderator's reason, shown to the chamber that submitted it. A
  /// rejection that does not say why is one the chamber cannot act on.
  shareNote    String    @default("") @map("share_note")
  /// The handle of whoever submitted it, for the chamber's own record.
  submittedBy  String    @default("") @map("submitted_by")

  /// The chamber that wrote it. Sharing it with every other chamber is the
  /// separate, moderated act above.
  firmId Int  @map("firm_id")
  firm   Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId])
  @@index([shareState, sharedAt])
  @@map("judgments")
}

model Research {
  id          Int       @id @default(autoincrement())
  title       String
  topic       String    @default("")
  summary     String    @default("")
  body        String    @default("")
  tags        String    @default("")
  caseId      Int?      @map("case_id")
  storedName  String    @default("") @map("stored_name")
  origName    String    @default("") @map("orig_name")
  sizeBytes   Int       @default(0) @map("size_bytes")
  published   Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")
  /// Whether this has been contributed to the shared library, and how far
  /// that has got: "private" | "pending" | "approved" | "rejected".
  ///
  /// A separate axis from `published`. `published` is the chamber's own
  /// decision about its own website; this is a decision to put the entry in
  /// front of every advocate on the platform, which only the platform admin
  /// can complete. An approved entry is a legal citation another advocate
  /// may rely on in court, so nothing reaches that state without somebody
  /// having checked it.
  shareState  String    @default("private") @map("share_state")
  /// When it was approved. Null until then.
  sharedAt    DateTime? @map("shared_at")
  /// The moderator's reason, shown to the chamber that submitted it. A
  /// rejection that does not say why is one the chamber cannot act on.
  shareNote   String    @default("") @map("share_note")
  /// The handle of whoever submitted it, for the chamber's own record.
  submittedBy String    @default("") @map("submitted_by")

  case Case? @relation(fields: [caseId], references: [id], onDelete: SetNull)

  firmId Int  @map("firm_id")
  firm   Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId])
  @@index([shareState, sharedAt])
  @@index([caseId])
  @@map("research")
}

model Media {
  id          Int       @id @default(autoincrement())
  title       String
  kind        String    @default("Video") // "Video" | "Lecture" | ...
  description String    @default("")
  topic       String    @default("")
  url         String    @default("")
  recordedOn  DateTime? @map("recorded_on") @db.Date
  storedName  String    @default("") @map("stored_name")
  origName    String    @default("") @map("orig_name")
  sizeBytes   Int       @default(0) @map("size_bytes")
  published   Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")
  /// Whether this has been contributed to the shared library, and how far
  /// that has got: "private" | "pending" | "approved" | "rejected".
  ///
  /// A separate axis from `published`. `published` is the chamber's own
  /// decision about its own website; this is a decision to put the entry in
  /// front of every advocate on the platform, which only the platform admin
  /// can complete. An approved entry is a legal citation another advocate
  /// may rely on in court, so nothing reaches that state without somebody
  /// having checked it.
  shareState  String    @default("private") @map("share_state")
  /// When it was approved. Null until then.
  sharedAt    DateTime? @map("shared_at")
  /// The moderator's reason, shown to the chamber that submitted it. A
  /// rejection that does not say why is one the chamber cannot act on.
  shareNote   String    @default("") @map("share_note")
  /// The handle of whoever submitted it, for the chamber's own record.
  submittedBy String    @default("") @map("submitted_by")

  firmId Int  @map("firm_id")
  firm   Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId])
  @@index([shareState, sharedAt])
  @@map("media")
}

// ---------------------------------------------------------------------------
// The public website
// ---------------------------------------------------------------------------

model Enquiry {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String   @default("")
  email     String   @default("")
  subject   String   @default("")
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  firmId Int  @map("firm_id")
  firm   Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId])
  @@map("enquiries")
}

/// Key/value settings the Principal edits from Site Settings — address,
/// phones, WhatsApp, map, social accounts. Anything absent falls back to a
/// constant in application config, so a fresh install works before anyone
/// has touched this table.
model Setting {
  key       String   @map("skey")
  value     String   @default("") @map("sval")
  updatedAt DateTime @updatedAt @map("updated_at")

  firmId Int  @map("firm_id")
  firm   Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  // Each chamber keeps its own address, telephone number and accounts.
  @@id([firmId, key])
  @@map("settings")
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  author    String
  role      String   @default("")
  body      String
  rating    Int      @default(5)
  source    String   @default("Google")
  sourceUrl String   @default("") @map("source_url")
  published Boolean  @default(true)
  sortOrder Int      @default(50) @map("sort_order")
  createdBy String   @default("") @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  firmId Int  @map("firm_id")
  firm   Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId, published, sortOrder])
  @@map("testimonials")
}

model Post {
  id          Int       @id @default(autoincrement())
  slug        String
  title       String
  summary     String    @default("")
  body        String    @default("")
  category    String    @default("")
  tags        String    @default("")
  coverName   String    @default("") @map("cover_name")
  coverOrig   String    @default("") @map("cover_orig")
  author      String    @default("")
  published   Boolean   @default(false)
  publishedOn DateTime? @map("published_on") @db.Date
  views       Int       @default(0)
  createdBy   String    @default("") @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  firmId Int  @map("firm_id")
  firm   Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  // Two chambers may each have an article at /blog/limitation.
  @@unique([firmId, slug])
  @@index([firmId, published, publishedOn])
  @@map("posts")
}

// The platform's data model. camelCase in code, snake_case in the database
// (via @map/@@map), so both SQL and TypeScript read naturally.
//
// Every table that holds a chamber's work carries `firmId`. It is
// denormalised deliberately — a hearing could be reached through its case,
// but a key on the row itself means every query can be scoped directly, and
// the tenant client (src/lib/tenant.ts) can enforce that uniformly instead
// of each call site remembering to join.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// The platform
// ---------------------------------------------------------------------------

/// A chamber: one lawyer's practice, with its own staff, clients and files.
///
/// Every other table below belongs to exactly one of these, and nothing in
/// one firm is reachable from another. The platform's own chamber is simply
/// the first row.
/// A reminder about money, and when it was put in front of a client.
///
/// A chamber needs to know when it last asked, for two reasons that pull in
/// the same direction: asking twice in a day reads as harassment, and not
/// asking for six months is how a fee quietly becomes uncollectable.
///
/// What is recorded is deliberately narrow. The app prepares a message and
/// hands it to WhatsApp; whether the advocate then pressed send, whether it
/// was delivered, whether it was read — none of that comes back, and a
/// record claiming otherwise would be a record a chamber could not rely on.
/// So this says only that a reminder was prepared and opened, on a date, by
/// a named person, for an amount that was outstanding at that moment.
model FeeReminder {
  id       Int      @id @default(autoincrement())
  clientId Int      @map("client_id")
  /// The matter it concerned, where it concerned one rather than the
  /// client's whole account.
  caseId   Int?     @map("case_id")
  /// What was outstanding when it was opened, kept because the figure
  /// moves and "we reminded them" means nothing without it.
  amount   Decimal  @db.Decimal(12, 2)
  /// How it was put in front of them. "whatsapp" today.
  channel  String   @default("whatsapp")
  openedBy String   @default("") @map("opened_by")
  openedAt DateTime @default(now()) @map("opened_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  case   Case?  @relation(fields: [caseId], references: [id], onDelete: SetNull)

  firmId Int  @map("firm_id")
  firm   Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId, clientId])
  @@index([firmId, caseId])
  @@map("fee_reminders")
}

model Firm {
  id              Int    @id @default(autoincrement())
  /// Used in URLs and invitations, e.g. "arbitrator-law".
  slug            String @unique
  name            String
  /// "active" | "suspended" — a suspended chamber cannot sign in at all.
  status          String @default("active")
  /// Set when the platform admin suspends it, for the message shown.
  suspendedReason String @default("") @map("suspended_reason")

  /// Whether the platform has checked that this really is an advocate.
  ///
  /// Anybody can type "advocate" into a sign-up form, so every chamber
  /// starts unverified. This deliberately does NOT restrict a chamber's own
  /// private use — that use is the product, and gating it on a manual check
  /// would mean nobody could start work on the day they signed up. It gates
  /// what becomes *public* in the chamber's name, and gives the platform
  /// admin something to act on.
  verified    Boolean  @default(false)
  /// Free text: an enrolment or bar council number as the advocate gave it.
  /// Stored as given and never treated as proof of anything by itself.
  enrolmentNo String   @default("") @map("enrolment_no")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users          User[]
  roles          Role[]
  roleCaps       RoleCap[]
  clients        Client[]
  cases          Case[]
  hearings       Hearing[]
  caseUpdates    CaseUpdate[]
  caseMessages   CaseMessage[]
  documents      Document[]
  fees           Fee[]
  officialFees   OfficialFee[]
  expenses       Expense[]
  communications Communication[]
  judgments      Judgment[]
  research       Research[]
  media          Media[]
  enquiries      Enquiry[]
  settings       Setting[]
  testimonials   Testimonial[]
  posts          Post[]
  pushTokens     PushToken[]
  diaryTasks     DiaryTask[]
  libraryFolders LibraryFolder[]
  feeReminders   FeeReminder[]

  @@map("firms")
}

// ---------------------------------------------------------------------------
// Accounts, roles and access
// ---------------------------------------------------------------------------

/// A staff account. The Principal (role "admin") always holds every
/// capability regardless of what role_caps says — enforced in application
/// code, not here, so a future capability is automatically covered.
model User {
  id Int @id @default(autoincrement())

  /// How this person signs in. Unique across the whole platform, because an
  /// address is already one person's and needs no chamber named beside it.
  /// An address ending `.invalid` is a placeholder written by the migration
  /// for an account that pre-dates email sign-in; it works, but the holder
  /// should replace it.
  email String @unique

  /// The handle inside the chamber — what signs a case update. Two chambers
  /// may each have a `naveed.ahmad`, which is the whole point of M2: the
  /// second advocate to join must not be told a name is taken because
  /// somebody in a chamber they cannot see is using it.
  username String

  passwordHash       String   @map("password_hash")
  fullName           String   @map("full_name")
  role               String
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  createdAt          DateTime @default(now()) @map("created_at")

  /// Runs the platform itself, not merely this chamber.
  ///
  /// Deliberately a property of a person rather than of a chamber. Tying it
  /// to "any Principal of the first chamber" would mean that the day a
  /// colleague is made Principal, they silently acquire the power to
  /// suspend other advocates' practices.
  ///
  /// It grants exactly what running a platform needs — chamber metadata,
  /// counts, verification and suspension — and nothing that reaches inside
  /// a chamber. There is no route anywhere that takes a chamber id and
  /// returns its records; see lib/platform-stats.ts.
  ///
  /// Granted only from the command line (npm run platform:grant), never
  /// through a screen, so it cannot be handed out by a session somebody
  /// left signed in.
  platformAdmin Boolean @default(false) @map("platform_admin")

  firmId Int  @map("firm_id")
  firm   Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@unique([firmId, username])
  @@index([firmId])
  @@map("users")
}

/// A role staff accounts are assigned. Three ship as defaults (admin, editor,
/// associate) but "Add a role of your own" is a first-class feature — any
/// role_key not in that starting set is just as valid.
model Role {
  id          Int      @id @default(autoincrement())
  roleKey     String   @map("role_key")
  label       String
  description String   @default("")
  isSystem    Boolean  @default(false) @map("is_system")
  sortOrder   Int      @default(50) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  firmId Int  @map("firm_id")
  firm   Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  // Each chamber names its own roles; two firms may both have a "Clerk".
  @@unique([firmId, roleKey])
  @@map("roles")
}

/// Which capabilities a role holds. The capability keys themselves
/// ("cases.view", "money.edit", ...) are defined in application code
/// (src/lib/capabilities.ts), not as a database enum, so the list can grow
/// without a migration.
model RoleCap {
  roleKey String @map("role_key")
  cap     String

  firmId Int  @map("firm_id")
  firm   Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@id([firmId, roleKey, cap])
  @@map("role_caps")
}

/// A device registered for push notifications, bound to the party that was
/// signed in when it registered. The token is unique: a handset that signs
/// in as somebody else is reassigned, never shared, so the previous holder's
/// notifications stop reaching it.
model PushToken {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  /// "client" | "staff" — the same two audiences as a session.
  kind       String
  subjectId  Int      @map("subject_id")
  platform   String   @default("")
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @updatedAt @map("last_seen_at")

  firmId Int  @map("firm_id")
  firm   Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId, kind, subjectId])
  @@map("push_tokens")
}

/// A counter of attempts, keyed by (scope, identity, ip).
///
/// Two things use it: sign-in throttling — where a client login and an office
/// login for the same name are counted independently — and the public
/// enquiry form, the one unauthenticated write on the site. The shape suits
/// both, so they share a table rather than a near-duplicate one.
/// What a platform admin did to somebody else's chamber, and why.
///
/// The counterpart of the power itself. Suspending a chamber stops an
/// advocate working, so it is not something that should be possible to do
/// quietly — every use is written down here with who did it and the reason
/// they gave. Platform-level by nature, so it carries no firm_id of its
/// own; `firm_id_acted_on` names the chamber it was done to.
model PlatformAudit {
  id            Int      @id @default(autoincrement())
  /// users.id of the platform admin. Not a relation: the record must
  /// outlive the account, or deleting yourself would erase what you did.
  actorId       Int      @map("actor_id")
  actorEmail    String   @map("actor_email")
  /// "verify" | "unverify" | "suspend" | "restore"
  action        String
  firmIdActedOn Int      @map("firm_id_acted_on")
  firmSlug      String   @map("firm_slug")
  reason        String   @default("")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([firmIdActedOn, createdAt])
  @@index([createdAt])
  @@map("platform_audit")
}

/// Deliberately *not* scoped to a chamber. A brute-forcer working through
/// usernames is one attacker whichever chamber they are guessing at, and the
/// throttle runs before a sign-in has told us which chamber that would be.
model RateLimit {
  id          Int       @id @default(autoincrement())
  scope       String
  identity    String
  ip          String
  attempts    Int       @default(0)
  lockedUntil DateTime? @map("locked_until")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([scope, identity, ip])
  @@map("rate_limits")
}

// ---------------------------------------------------------------------------
// Clients and cases
// ---------------------------------------------------------------------------

model Client {
  id                       Int      @id @default(autoincrement())
  name                     String
  /// How a client is told apart from the other three of the same name. In
  /// this jurisdiction a person is named with their father's, on the file
  /// and at the bar, and a chamber that keeps only the given name loses
  /// them.
  fatherName               String   @default("") @map("father_name")
  /// The national identity number. Kept as written, not validated: a
  /// chamber records what the client's card says, and an old card, a
  /// smudged photocopy and a number given over the telephone all have to
  /// go in. It is also how a client is looked up.
  cnic                     String   @default("")
  phone                    String   @default("")
  email                    String   @default("")
  address                  String   @default("")
  portalEnabled            Boolean  @default(false) @map("portal_enabled")
  /// Unique within the chamber, not the platform. A client may have no
  /// email at all — an elderly litigant very often does not — so they keep
  /// a username, and the chamber comes from the link their advocate sent
  /// them rather than from anything they have to remember.
  portalUsername           String?  @map("portal_username")
  portalHash               String?  @map("portal_hash")
  /// Set when the office issues or resets a portal password; the portal
  /// refuses every other route until the client has chosen their own.
  portalMustChangePassword Boolean  @default(false) @map("portal_must_change_password")
  portalShowFees           Boolean  @default(false) @map("portal_show_fees")
  notes                    String   @default("")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  cases          Case[]
  communications Communication[]
  tasks          DiaryTask[]
  feeReminders   FeeReminder[]

  firmId Int  @map("firm_id")
  firm   Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@unique([firmId, portalUsername])
  @@index([firmId])
  @@map("clients")
}

model Case {
  id            Int       @id @default(autoincrement())
  clientId      Int       @map("client_id")
  /// Written as the parties: "X vs Y". That is how a matter is spoken of
  /// in court and how an advocate looks for it.
  title         String
  /// The number the court calls it by. Free text because a number is a
  /// number in one court, and a number with a year, a class and a suffix
  /// in the next.
  caseNo        String    @default("") @map("case_no")
  court         String    @default("")
  caseType      String    @default("") @map("case_type")
  /// The provisions the matter turns on.
  sections      String    @default("")
  /// The FIR, for a criminal matter: its number, the police station, the
  /// date — as the file records them.
  firDetails    String    @default("") @map("fir_details")
  /// Which side this chamber is on — petitioner, respondent, complainant,
  /// accused. Free text, because the word changes with the forum.
  ourSide       String    @default("") @map("our_side")
  /// The party on the other side, which is not always the same as the
  /// second half of the title.
  opposingParty String    @default("") @map("opposing_party")
  /// The judge or bench it is before.
  judge         String    @default("")
  /// Where the matter has reached — framing of issues, evidence,
  /// arguments, reserved. Distinct from status: a case may be Active and
  /// at evidence, or Active and reserved.
  stage         String    @default("")
  status        String    @default("Active")
  /// When it was instituted.
  filedOn       DateTime? @map("filed_on") @db.Date
  nextHearing   DateTime? @map("next_hearing") @db.Date
  /// Who in the chamber is carrying it.
  assignedTo    String    @default("") @map("assigned_to")
  /// Internal only — never shown to the client portal.
  notes         String    @default("")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  hearings       Hearing[]
  updates        CaseUpdate[]
  messages       CaseMessage[]
  documents      Document[]
  fees           Fee[]
  research       Research[]
  tasks          DiaryTask[]
  expenses       Expense[]
  communications Communication[]

  firmId      Int           @map("firm_id")
  firm        Firm          @relation(fields: [firmId], references: [id], onDelete: Cascade)
  FeeReminder FeeReminder[]

  @@index([firmId])
  @@index([clientId])
  @@map("cases")
}

/// A thing to be done, with or without a court date behind it.
///
/// The chamber's diary is not the cause list. The cause list is what the
/// courts have fixed; this is everything else an advocate must not forget —
/// file the rejoinder, collect the certified copy, telephone the client
/// before the date, pay the process fee. It is the half of the day that has
/// no hearing attached to it, and a practice is lost through this half
/// rather than through the listed one.
model DiaryTask {
  id        Int       @id @default(autoincrement())
  /// The day it is to be done. A task with a date in the past and `done`
  /// still false is what "overdue" means; nothing else marks it.
  taskDate  DateTime  @map("task_date") @db.Date
  title     String
  notes     String    @default("")
  /// How much it matters. Free text rather than an enum: a chamber's own
  /// words for urgency outlive any list decided here.
  priority  String    @default("Normal")
  /// What it is about. Either, both or neither — a task may hang off a
  /// matter, off a person, or off nothing at all.
  caseId    Int?      @map("case_id")
  clientId  Int?      @map("client_id")
  done      Boolean   @default(false)
  doneAt    DateTime? @map("done_at")
  /// Who wrote it down, so a chamber of three can tell whose it was.
  createdBy String    @default("") @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  case   Case?   @relation(fields: [caseId], references: [id], onDelete: SetNull)
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  firmId Int  @map("firm_id")
  firm   Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId, taskDate])
  @@index([firmId, done])
  @@index([caseId])
  @@index([clientId])
  @@map("diary_tasks")
}

model Hearing {
  id             Int       @id @default(autoincrement())
  caseId         Int       @map("case_id")
  hearingDate    DateTime  @map("hearing_date") @db.Date
  purpose        String    @default("")
  /// Internal only — never shown to the client portal.
  outcome        String    @default("")
  /// What the court actually wrote, copied from the order sheet. Kept
  /// apart from `outcome`, which is the chamber's own note of what
  /// happened: one is the record, the other is the reading of it.
  orderSheet     String    @default("") @map("order_sheet")
  /// Who appeared. Often not the advocate whose file it is.
  attendedBy     String    @default("") @map("attended_by")
  /// The date the court gave from the bench. Recording it moves the
  /// case's next hearing, which is why a hearing can be entered once and
  /// the cause list is right afterwards.
  nextDate       DateTime? @map("next_date") @db.Date
  /// When the reminder for this hearing went out, so a re-run of the
  /// reminder job never tells anyone twice.
  reminderSentAt DateTime? @map("reminder_sent_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  firmId Int  @map("firm_id")
  firm   Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId])
  @@index([caseId])
  @@map("hearings")
}

/// A progress note posted to a case. Client-visible by design — this is how
/// a client sees what has happened without phoning the office.
model CaseUpdate {
  id         Int      @id @default(autoincrement())
  caseId     Int      @map("case_id")
  updateDate DateTime @map("update_date") @db.Date
  message    String
  author     String
  createdAt  DateTime @default(now()) @map("created_at")

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  firmId Int  @map("firm_id")
  firm   Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId])
  @@index([caseId])
  @@map("case_updates")
}

/// The message thread between a client and the office on one case, including
/// client voice notes (storedName set when the message carries a recording).
model CaseMessage {
  id         Int      @id @default(autoincrement())
  caseId     Int      @map("case_id")
  authorType String   @map("author_type") // "client" | "office"
  authorName String   @default("") @map("author_name")
  body       String   @default("")
  storedName String   @default("") @map("stored_name")
  origName   String   @default("") @map("orig_name")
  answered   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  firmId Int  @map("firm_id")
  firm   Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId])
  @@index([caseId])
  @@map("case_messages")
}

model Document {
  id            Int      @id @default(autoincrement())
  caseId        Int      @map("case_id")
  title         String
  storedName    String   @default("") @map("stored_name")
  origName      String   @default("") @map("orig_name")
  sizeBytes     Int      @default(0) @map("size_bytes")
  /// Private by default — an office action must deliberately mark a
  /// document Shared before a client can see it.
  clientVisible Boolean  @default(false) @map("client_visible")
  createdAt     DateTime @default(now()) @map("created_at")

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  firmId Int  @map("firm_id")
  firm   Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId])
  @@index([caseId])
  @@map("documents")
}

// ---------------------------------------------------------------------------
// Money
// ---------------------------------------------------------------------------

model Fee {
  id        Int      @id @default(autoincrement())
  caseId    Int      @map("case_id")
  kind      String // "agreed" | "received"
  amount    Decimal  @db.Decimal(12, 2)
  entryDate DateTime @map("entry_date") @db.Date
  /// Cash, bank, cheque, easypaisa. Free text: how money reaches a chamber
  /// changes faster than any list written here would.
  mode      String   @default("")
  /// The receipt the client was given. This is the number a client quotes
  /// when they say they have already paid.
  receiptNo String   @default("") @map("receipt_no")
  note      String   @default("")
  /// Who entered it, so a chamber of three can account for its own books.
  createdBy String   @default("") @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  firmId Int  @map("firm_id")
  firm   Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId])
  @@index([caseId])
  @@map("fees")
}

model OfficialFee {
  id          Int       @id @default(autoincrement())
  caseId      Int?      @map("case_id")
  kind        String
  description String    @default("")
  amount      Decimal   @db.Decimal(12, 2)
  entryDate   DateTime  @map("entry_date") @db.Date
  receiptNo   String    @default("") @map("receipt_no")
  /// Whether the chamber laid this out or the client paid it directly.
  /// Money the chamber advanced is money owed back, and that is the whole
  /// reason this is recorded apart from a professional fee.
  paidBy      String    @default("office") @map("paid_by")
  /// When the chamber got it back. Null while it is still out of pocket,
  /// which is what makes a list of unrecovered court fees possible.
  recoveredAt DateTime? @map("recovered_at")
  note        String    @default("")
  createdBy   String    @default("") @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  firmId Int  @map("firm_id")
  firm   Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId])
  @@map("official_fees")
}

model Expense {
  id          Int      @id @default(autoincrement())
  category    String
  amount      Decimal  @db.Decimal(12, 2)
  expenseDate DateTime @map("expense_date") @db.Date
  description String   @default("")
  /// Who received it — the stationer, the clerk, the courier.
  paidTo      String   @default("") @map("paid_to")
  mode        String   @default("")
  /// An expense may belong to a matter, and then it is recoverable; or to
  /// the office, and then it is simply the cost of keeping the doors open.
  caseId      Int?     @map("case_id")
  createdBy   String   @default("") @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  case Case? @relation(fields: [caseId], references: [id], onDelete: SetNull)

  firmId Int  @map("firm_id")
  firm   Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId])
  @@index([caseId])
  @@map("expenses")
}

// ---------------------------------------------------------------------------
// Diary
// ---------------------------------------------------------------------------

model Communication {
  id           Int       @id @default(autoincrement())
  clientId     Int?      @map("client_id")
  /// A call about a matter belongs to the matter, not only to the person.
  caseId       Int?      @map("case_id")
  method       String // "call" | "email" | "in_person"
  /// Who rang whom. A chamber defending what it advised needs to be able
  /// to say the client telephoned it, or that it telephoned the client.
  direction    String    @default("Received")
  /// The person at the other end, who is very often not the client: the
  /// opposing counsel, a reader, a relative bringing a message.
  personName   String    @default("") @map("person_name")
  personNumber String    @default("") @map("person_number")
  /// What they were — client, opposing counsel, court staff, witness.
  personRole   String    @default("") @map("person_role")
  subject      String    @default("")
  summary      String
  commDate     DateTime  @map("comm_date") @db.Date
  /// The hour it happened. Kept as written rather than as a timestamp: a
  /// note made in the evening about a call at eleven should say eleven.
  commTime     String    @default("") @map("comm_time")
  followUpDue  DateTime? @map("follow_up_due") @db.Date
  createdBy    String    @default("") @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")

  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  case   Case?   @relation(fields: [caseId], references: [id], onDelete: SetNull)

  firmId Int  @map("firm_id")
  firm   Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId])
  @@index([clientId])
  @@map("communications")
}

// ---------------------------------------------------------------------------
// Library — public once published
// ---------------------------------------------------------------------------

/// A shelf in a chamber's own library.
///
/// The library fills up faster than anything else in an office — every
/// judgment worth keeping, every note written while researching a point —
/// and a flat list of four hundred entries is one nobody looks in. A
/// chamber shelves them its own way: by court, by subject, by the matter
/// they were written for.
///
/// Folders are per kind. Judgments and written notes are not filed
/// together on a real shelf and there is no reason to force it here.
model LibraryFolder {
  id        Int      @id @default(autoincrement())
  /// "judgments" | "research" | "media"
  kind      String
  name      String
  /// The chamber's own order, so a shelf can be arranged rather than
  /// alphabetised for it.
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  judgments Judgment[]
  research  Research[]
  media     Media[]

  firmId Int  @map("firm_id")
  firm   Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@unique([firmId, kind, name])
  @@index([firmId, kind])
  @@map("library_folders")
}

model Judgment {
  id           Int       @id @default(autoincrement())
  title        String
  citation     String    @default("")
  court        String    @default("")
  judges       String    @default("")
  judgmentDate DateTime? @map("judgment_date") @db.Date
  sections     String    @default("")
  principle    String    @default("")
  summary      String    @default("")
  tags         String    @default("")
  sourceUrl    String    @default("") @map("source_url")
  storedName   String    @default("") @map("stored_name")
  origName     String    @default("") @map("orig_name")
  sizeBytes    Int       @default(0) @map("size_bytes")
  published    Boolean   @default(false)
  createdAt    DateTime  @default(now()) @map("created_at")
  /// Whether this has been contributed to the shared library, and how far
  /// that has got: "private" | "pending" | "approved" | "rejected".
  ///
  /// A separate axis from `published`. `published` is the chamber's own
  /// decision about its own website; this is a decision to put the entry in
  /// front of every advocate on the platform, which only the platform admin
  /// can complete. An approved entry is a legal citation another advocate
  /// may rely on in court, so nothing reaches that state without somebody
  /// having checked it.
  shareState   String    @default("private") @map("share_state")
  /// When it was approved. Null until then.
  sharedAt     DateTime? @map("shared_at")
  /// The moderator's reason, shown to the chamber that submitted it. A
  /// rejection that does not say why is one the chamber cannot act on.
  shareNote    String    @default("") @map("share_note")
  /// The handle of whoever submitted it, for the chamber's own record.
  submittedBy  String    @default("") @map("submitted_by")

  /// The chamber that wrote it. Sharing it with every other chamber is the
  /// separate, moderated act above.
  /// The shelf it is on, if any. Removing a shelf leaves what was on
  /// it in the library rather than destroying it — a folder is how a
  /// chamber arranges its work, not what the work belongs to.
  folderId Int?           @map("folder_id")
  folder   LibraryFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  firmId Int  @map("firm_id")
  firm   Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId])
  @@index([shareState, sharedAt])
  @@map("judgments")
}


// ---------------------------------------------------------------------------
// The public website
// ---------------------------------------------------------------------------

model Enquiry {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String   @default("")
  email     String   @default("")
  subject   String   @default("")
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  firmId Int  @map("firm_id")
  firm   Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId])
  @@map("enquiries")
}

/// Key/value settings the Principal edits from Site Settings — address,
/// phones, WhatsApp, map, social accounts. Anything absent falls back to a
/// constant in application config, so a fresh install works before anyone
/// has touched this table.
model Setting {
  key       String   @map("skey")
  value     String   @default("") @map("sval")
  updatedAt DateTime @updatedAt @map("updated_at")

  firmId Int  @map("firm_id")
  firm   Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  // Each chamber keeps its own address, telephone number and accounts.
  @@id([firmId, key])
  @@map("settings")
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  author    String
  role      String   @default("")
  body      String
  rating    Int      @default(5)
  source    String   @default("Google")
  sourceUrl String   @default("") @map("source_url")
  published Boolean  @default(true)
  sortOrder Int      @default(50) @map("sort_order")
  createdBy String   @default("") @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  firmId Int  @map("firm_id")
  firm   Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId, published, sortOrder])
  @@map("testimonials")
}

model Post {
  id          Int       @id @default(autoincrement())
  slug        String
  title       String
  summary     String    @default("")
  body        String    @default("")
  category    String    @default("")
  tags        String    @default("")
  coverName   String    @default("") @map("cover_name")
  coverOrig   String    @default("") @map("cover_orig")
  author      String    @default("")
  published   Boolean   @default(false)
  publishedOn DateTime? @map("published_on") @db.Date
  views       Int       @default(0)
  createdBy   String    @default("") @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  firmId Int  @map("firm_id")
  firm   Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  // Two chambers may each have an article at /blog/limitation.
  @@unique([firmId, slug])
  @@index([firmId, published, publishedOn])
  @@map("posts")
}

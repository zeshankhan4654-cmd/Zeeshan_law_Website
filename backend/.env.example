# Copy this file to .env and fill in real values. .env is git-ignored —
# never commit real secrets.

# The server
PORT=4000
NODE_ENV=development

# Postgres — used directly in Phase 0's health check; Prisma's DATABASE_URL
# is added in Phase 1 once the schema exists.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=zeeshan_law
PGUSER=postgres
PGPASSWORD=

# The browser origin allowed to call this API (the Next.js dev server).
CORS_ORIGIN=http://localhost:3000

# Auth — added in Phase 1. Generate a real value with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET=

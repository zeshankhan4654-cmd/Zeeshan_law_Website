# Copy this file to .env and fill in real values. .env is git-ignored —
# never commit real secrets.

PORT=4000
NODE_ENV=development

# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/zeeshan_law?schema=public

# Browser origins allowed to call this API, comma-separated: the Next.js app,
# and Expo's web target during mobile development.
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# Signs the session cookie. Generate a real value with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_to_a_random_64_char_hex_string
JWT_EXPIRES_IN=12h

# Which chamber's website this deployment serves on its bare domain. Behind
# a sign-in the chamber comes from the session; the public pages have no
# session, so they are told here. It must match a row in `firms`.
PLATFORM_FIRM_SLUG=arbitrator-law

# Login throttling
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

# Where uploaded case documents and client voice notes are written. Relative
# paths resolve against the backend folder; put this outside the repository
# tree on a real server.
UPLOAD_DIR=./uploads
VOICE_NOTE_MAX_MB=10

# Push notifications. "log" prints what would be sent and sends nothing —
# the right setting on a development machine. "expo" sends for real.
PUSH_TRANSPORT=log
PUSH_API_URL=https://exp.host/--/api/v2/push/send

# Reverse proxies in front of this server (nginx, a hosting panel). 0 means
# the server is reached directly. Rate limits are keyed on the caller's
# address, so this must match the deployment exactly.
TRUST_PROXY_HOPS=0
